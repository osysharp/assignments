// Osysharp.Assignments.Allocations — what several assignments compete for, and who holds how much of it.
//
// Assignments opened under one outcome often draw on the same thing: the stock in one warehouse, a production
// line's hours next week, a sum of money. Each is planned by somebody who sees their own part. This kit is the one
// place that says how much there is, who holds what, who is waiting — and what happens when there turns out to be
// less than was thought.
//
//     var stock = OpenPool(new NewPool { Key = "malmo-housings", Title = "Housings in the Malmö warehouse", Unit = "housings", Available = 120 });
//     Claim(stock, nordics, 80, "Nordic orders due this month");   // held: nobody else can take these 80
//     Claim(stock, dach, 60, "DACH orders due this month");        // refused — 40 are left, and it says what the rest is held for
//     AskFor(stock, dach, 60, "DACH orders due this month");       // …or it waits its turn, and the assignment says what it waits for
//
// ⚑ TWO ASSIGNMENTS NEVER HOLD THE SAME UNIT. A claim that does not fit is refused, saying what the rest is held for.
//   The pool's held amount is checked on every write (`[ConcurrencyCheck]`), so of two claims made at the same moment
//   the second is refused as a conflict.
//
// ⚑ WHOEVER SEES A POOL NEED NOT BE ON THE ASSIGNMENTS THAT DRAW ON IT. A claim says what it is for in its
//   claimant's own words, and that is what the others read; an assignment's title is shown only to who may read it.
//
// ⚑ LESS THAN WAS THOUGHT IS NOBODY'S FAULT AND SOMEBODY'S DECISION. `CorrectPool` records what there is now. If more
//   is held than there is, the pool is overdrawn: every assignment that holds some of it is told its share is in
//   question, and whoever keeps the pool decides who gives way (`CutAllocation`) — the kit never chooses a loser.
//   `PoolOverdrawn` and `AllocationCut` are events an app hears to plan again.
//
// ⚑ AN ASSIGNMENT THAT IS CLOSED HOLDS NOTHING. Completed, called off or failed, what it held goes back, and whoever
//   was waiting is given it in the order they asked.
package Osysharp.Assignments.Allocations {
  version     "1.2.0";
  minPlatform "0.17.0";
  summary     "shared resources between assignments: a pool with a counted amount (stock, hours, money), claims that are held or refused so two assignments never hold the same unit, claims that wait their turn, what happens when there is less than was thought (the pool is overdrawn, each holder is told, the pool's keeper decides who gives way), and release when an assignment closes; with the pool's page and a panel on every assignment";

  model "model/**/*.osy";
  tests "tests";
  use Osysharp.Assignments@2;
  use Osysharp.Identity@0;
  use Osysharp.Llm@2;
  use Osysharp.Workflow;
  use Osysharp.Ui;
}
