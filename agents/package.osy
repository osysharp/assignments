// Osysharp.Assignments.Agents — an agent's work, attached to the assignment it is for.
//
//     var outcome = await AssignedWork.Do(a, Agents.Of<Tracer>(), new TraceParcel(), order, key: "trace");
//
// ⚑ THE ASSIGNMENT OWNS THE WORK; THE RUN IS REPLACEABLE. The piece of work is attached to the assignment under its
//   key BEFORE the agent starts, in a unit of work of its own — so a run that dies leaves the assignment saying what
//   it was waiting on. Asked for again under the same key, work that had finished is answered from its receipt with
//   no model called; work that never reported back is run again; work that failed is a new attempt.
//
// ⚑ WHAT IT COST IS THE ASSIGNMENT'S COST. When the work ends, what its receipt says it spent — and what any work it
//   handed on spent — is counted on the assignment. An assignment whose budget is spent starts no more agent work.
//
// ⚑ A BRIDGE, SO NEITHER KIT DEPENDS ON THE OTHER. An app that uses Osysharp.Assignments and Osysharp.Agents writes
//   nothing to get it: `osy lock` includes it and says so.
package Osysharp.Assignments.Agents {
  version     "1.6.0";
  minPlatform "0.17.0";
  summary     "an agent's work attached to the assignment it is for: attached under a key before the run starts, answered from its receipt when it had already finished, run again when it never reported back; its cost counted on the assignment, refused once the assignment's budget is spent; called off when the assignment is; work the agent hands on to other agents is attached to the same assignment, a piece each, and the whole is counted once.";
  completes   Osysharp.Assignments@2, Osysharp.Agents@1;
  model "model/*.osy";
  tests "tests";
  use Osysharp.Assignments@2;
  use Osysharp.Agents@1;
  use Osysharp.Llm@2;
  use Osysharp.Identity@0;
  use Osysharp.Observability;
}
