// The delivery case, end to end: a customer's report becomes an assignment with criteria; an agent's work is attached
// to it; what its tools write down is kept as items; the customer is asked and answers; the refund is made once; the case closes
// by its criteria with what it cost — and is opened again when the refund does not arrive, with everything it had.
//
// The numbers. The shop's model costs $1 a million tokens in and $5 out, so a scripted answer of 100 in and 20 out
// costs 200 millionths of a dollar.
using Osysharp.Identity;
using Osysharp.Llm;
using Osysharp.Agents;
using Osysharp.Agents.Testing;
using Osysharp.Assignments;
using Osysharp.Assignments.Agents;
using Osysharp.WorkRepositories;
using Teashop;

[Test(Shop)]
void a_delivery_case_is_carried_from_the_customers_report_to_a_verified_outcome_and_opened_again() {
  TestClock.Set(Tuesday());
  var id = NoraReports();

  // ── the case is an assignment: who asked, the outcome wanted, what done means ──
  runas (Nora) {
    var a = Case(id).Assignment;
    Assert.Equal("Order T-1042 has not arrived", a.Title);
    Assert.Equal("The customer has the order, or their money back. I need it before Friday.", a.Goal);
    Assert.Equal(Nora.Id, a.Requester.Id);
    Assert.Equal(Sana.Id, a.Owner!.Id);
    Assert.Equal(Friday(), a.DueAt);
    Assert.Equal(["The parcel is delivered or the order is refunded", "The customer has been told the outcome"],
                 a.Criteria.OrderBy(c => c.Position).ToList().Select(c => c.Text).ToList());
    Assert.Equal("delivery-resolution", a.Process);
  }

  // ── an agent finds out where the parcel is, as a piece of work of the case ──
  Guid investigation = Guid.Empty;
  runas (Sana) {
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
    var outcome = Investigate(Case(id));
    Assert.True(outcome.Done);
    Assert.True(outcome.Result.Lost);
    Assert.Equal("refund", outcome.Result.Suggests);
    Assert.Equal(["CheckOrder", "TrackParcel", "NoteEvidence"], Trajectory.Of(outcome.Task));
    investigation = outcome.Task;
  }
  Background.Settle();
  runas (Sana) {
    var a = Case(id).Assignment;
    // The work is attached to the case, settled, and its cost is the case's: four answers at 200 millionths.
    var work = WorkOf(a, "investigate")!;
    Assert.Equal(WorkKind.AgentTask, work.Kind);
    Assert.Equal(WorkState.Done, work.State);
    Assert.Equal("Find out where order T-1042 is", work.Title);
    Assert.Equal(investigation, work.Subject);
    Assert.Equal(800, work.CostMicros);
    Assert.Equal("Resolver finished it.", work.Result);
    Assert.Equal(800, CostOf(a).WorkMicros);
    // What it found is in the repository as an ITEM: the evidence its tool wrote down, as the agent's own. (Filing
    // what it handed back as a finding, and tracing an item to the piece of work, is
    // Osysharp.WorkRepositories.Agents' — shown by that bridge's own tests.)
    var evidence = ItemsOf(a, ItemKind.Evidence).Single();
    Assert.Equal("Carrier scans for PL7731", evidence.Title);
    Assert.Equal(ContributorKind.Actor, evidence.AddedAs);
    Assert.Equal(Agents.Of<Resolver>().Actor.Id, evidence.AddedBy!.Id);
    Assert.Equal("Postline tracking", CurrentOf(evidence).From);
    Assert.Equal(0, ItemsOf(a, ItemKind.Finding).Count);
    // Finished agent work completes nothing: both criteria are unmet, and the case says so.
    Assert.Equal("2 of 2 criteria are not met: “The parcel is delivered or the order is refunded”, “The customer has been told the outcome”.", CompletionOf(a).Why);
    Assert.True(ConditionsOf(a).Clear);

    // ── the customer is asked, and the case waits on her ──
    AskCustomer(Case(id), "The parcel was damaged on the way. A replacement next week, or a refund?", Tuesday().AddDays(2));
    var c = ConditionsOf(Case(id).Assignment);
    Assert.Equal(["Waiting"], c.Names());
    Assert.Equal(["Nora Lind"], c.NextStepWith);
  }
  TestClock.Advance(TimeSpan.FromHours(20));
  runas (Nora) { CustomerAnswers(Case(id), "A refund, please. Next week is too late."); }
  TestClock.Advance(TimeSpan.FromHours(1));

  // ── the agent settles it: one refund, a letter; support records the decision; the criteria are met ──
  runas (Sana) {
    Assert.True(ConditionsOf(Case(id).Assignment).Clear);
    var script = SettlementScript(Case(id));
    ScriptedAnswer.Stub((model, request) => request.Tools.Count == 0
      ? Scripted.Text("The parcel was lost in transit; the order was refunded in full and the customer told.")
      : script.Answer(model, request));
    var settled = Settle(Case(id));
    Assert.True(settled.Result.Refunded);
    Assert.Equal(OrderStatus.Refunded, ShopOrder.Single(o => o.Number == "T-1042").Status);
    Assert.Equal(1, ShopOrder.Single(o => o.Number == "T-1042").Refunds);

    DecideRefund(Case(id), "Lost in transit; the customer chose a refund over a replacement.");
    TellCustomer(Case(id), "We have refunded 42.00 EUR for order T-1042. We are sorry it never reached you.");
    var a = Case(id).Assignment;
    Assert.True(CompletionOf(a).Ready);
    var resolved = CriterionOf(a, "resolved");
    Assert.Equal("Refunded in full", resolved.MetBy);
    Assert.Equal(ItemOf(a, "decision")!.Id, resolved.Evidence);

    CloseCase(Case(id));
  }
  Background.Settle();

  // ── closed by its criteria, with its outcome, what somebody still owes, and what it cost ──
  runas (Lars) {
    var a = Case(id).Assignment;
    Assert.Equal(AssignmentState.Completed, a.State);
    Assert.Equal("The parcel was lost in transit; the order was refunded in full and the customer told.", a.Outcome);
    Assert.Equal("Watch that the refund reaches the customer's bank.", a.Obligations);
    // Two pieces of agent work — four answers and three — and the closing summary: 800 + 600 + 200.
    var cost = CostOf(a);
    Assert.Equal(1400, cost.WorkMicros);
    Assert.Equal(200, cost.OwnMicros);
    Assert.Equal(1600, cost.TotalMicros);
    Assert.Equal(50000, cost.BudgetMicros);
    // The repository holds the case: the evidence, the decision, and every word exchanged with the customer.
    Assert.Equal(1, ItemsOf(a, ItemKind.Evidence).Count);
    Assert.Equal(1, ItemsOf(a, ItemKind.Decision).Count);
    Assert.Equal(["Asked the customer", "The customer's answer", "Refund confirmation", "Told the customer"],
                 ItemsOf(a, ItemKind.Correspondence).Select(i => i.Title).ToList());
    // What was said to and by the customer is kept for a year from the close.
    Assert.Equal(DateTime.UtcNow.AddDays(365), ItemOf(a, "customer-answer")!.RetainUntil);
    Assert.Equal(["Find out where order T-1042 is", "Ask the customer: The parcel was damaged on the way. A replacement next week, or a refund?",
                  "Settle order T-1042", "Refund order T-1042"],
                 a.Work.OrderBy(w => w.Number).ToList().Select(w => w.Title).ToList());
  }

  // ── a week later the money has not come: the SAME case is opened again, with everything it had ──
  TestClock.Advance(TimeSpan.FromDays(7));
  runas (Nora) {
    var a = Case(id).Assignment;
    ReopenAssignment(a, "The refund has not reached my bank.", [CriterionOf(a, "resolved")]);
  }
  Background.Settle();
  runas (Sana) {
    var a = Case(id).Assignment;
    Assert.Equal(AssignmentState.Open, a.State);
    Assert.Equal(1, a.Reopened);
    Assert.Equal(CriterionState.Unmet, CriterionOf(a, "resolved").State);
    Assert.Equal(CriterionState.Met, CriterionOf(a, "told").State);
    Assert.Equal(6, ItemsOf(a).Count);
    Assert.Equal(4, a.Work.Count());
    Assert.Equal(1600, CostOf(a).TotalMicros);
    Assert.Null(ItemOf(a, "customer-answer")!.RetainUntil);
    // The refund is found, not made twice: the case knows it was done.
    Assert.Equal("Already refunded: 42.00 EUR refunded: Lost in transit", RefundOrder(Case(id).Order, "Again"));
    Assert.Equal(1, ShopOrder.Single(o => o.Number == "T-1042").Refunds);
    Assert.Throws<CriteriaUnmet>(() => CompleteAssignment(a, "Done again."));
  }
}

// ── surviving a crash ───────────────────────────────────────────────────────────────────────────────────────────────

[Test(Shop)]
void an_assignment_resumes_after_a_crash_during_agent_work() {
  var id = NoraReports();
  runas (Sana) {
    // The model answers twice, and then the process dies under it.
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => {
      if (TurnOf(request) >= 2) { throw new InvalidOperationException("The process died."); }
      return script.Answer(model, request);
    });
    Assert.Throws<InvalidOperationException>(() => Investigate(Case(id)));
  }

  // Nothing is running. The case still knows what it was waiting on, and from whom.
  runas (Sana) {
    var a = Case(id).Assignment;
    Assert.Equal(AssignmentState.Open, a.State);
    var work = WorkOf(a, "investigate")!;
    Assert.Equal(WorkState.Open, work.State);
    // It names the receipt of the run that died: the receipt was noted on the case before the run began.
    Assert.NotNull(work.Subject);
    Assert.Equal(["Waiting on Resolver for its result."], ConditionsOf(a).WaitingWhy);
    Assert.Equal(0, ItemsOf(a).Count);
  }

  // The step is run again. The same piece of work is picked up — not a second one — and this time it finishes.
  Guid finished = Guid.Empty;
  runas (Sana) {
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
    var outcome = Investigate(Case(id));
    Assert.True(outcome.Done);
    finished = outcome.Task;
  }
  Background.Settle();
  runas (Sana) {
    var a = Case(id).Assignment;
    Assert.Equal(1, a.Work.Count(w => w.Kind == WorkKind.AgentTask));
    var work = WorkOf(a, "investigate")!;
    Assert.Equal(WorkState.Done, work.State);
    Assert.Equal(finished, work.Subject);
    Assert.Contains("Find out where order T-1042 is: Started again; the earlier run did not report back.", ActivityOf(a).Select(l => l.Said).ToList());
    // What the finished run wrote down is there, once.
    Assert.Equal(1, ItemsOf(a, ItemKind.Evidence).Count);
  }
  // The run that died left its receipt — still "working", and called off when the step was run again — and the one
  // that finished left its own.
  runas (Lars) {
    Assert.Equal(1, AgentTask.Count(t => t.Status == AgentTaskStatus.Working && t.StopAsked));
    Assert.Equal(1, AgentTask.Count(t => t.Status == AgentTaskStatus.Done && t.Id == finished));
    // Nothing is doing it, and half an hour on that can be seen: whoever supervises the agents closes what was
    // abandoned, and no receipt says work is under way that is not.
    TestClock.Advance(TimeSpan.FromMinutes(31));
    Assert.Equal(1, CloseAbandonedAgentWork());
    UnitOfWork.Commit();
  }
  Background.Settle();
  runas (Lars) {
    Assert.Equal(0, AgentTask.Count(t => t.Status == AgentTaskStatus.Working || t.Status == AgentTaskStatus.Waiting));
    var died = AgentTask.Single(t => t.Id != finished);
    Assert.Equal(AgentTaskStatus.Cancelled, died.Status);
    Assert.Equal("It was called off: It was started again: the earlier run did not report back.", died.Outcome);
  }
  // The assignment's work is as the run that finished left it.
  runas (Sana) { Assert.Equal(WorkState.Done, WorkOf(Case(id).Assignment, "investigate")!.State); }
}

[Test(Shop)]
void an_assignment_resumes_after_a_crash_during_a_tool_call_without_repeating_its_effect() {
  var id = NoraReports();
  runas (Sana) {
    // The model asks for the refund; the refund is made; and the process dies before the model hears about it.
    var script = SettlementScript(Case(id));
    ScriptedAnswer.Stub((model, request) => {
      if (TurnOf(request) >= 1) { throw new InvalidOperationException("The process died."); }
      return script.Answer(model, request);
    });
    Assert.Throws<InvalidOperationException>(() => Settle(Case(id)));
    Assert.Equal(1, ShopOrder.Single(o => o.Number == "T-1042").Refunds);
    Assert.Equal(WorkState.Open, WorkOf(Case(id).Assignment, "settle")!.State);
  }

  // The step is run again from the top: the model asks for the refund a second time.
  runas (Sana) {
    var script = SettlementScript(Case(id));
    ScriptedAnswer.Stub((model, request) => {
      NoteToolResults(request);
      return script.Answer(model, request);
    });
    var settled = Settle(Case(id));
    Assert.True(settled.Done);
  }
  runas (Sana) {
    // The customer was refunded once. The second ask was answered from what the case had recorded.
    Assert.Equal(1, ShopOrder.Single(o => o.Number == "T-1042").Refunds);
    Assert.Equal(1, Heard.Count(h => h.What == "told" && h.About == "\"Already refunded: 42.00 EUR refunded: Lost in transit\""));
    var a = Case(id).Assignment;
    Assert.Equal(1, a.Work.Count(w => w.Kind == WorkKind.Action));
    Assert.Equal("42.00 EUR refunded: Lost in transit", DoneFor(a, "refund:T-1042")!.Result);
    Assert.Equal(WorkState.Done, WorkOf(a, "settle")!.State);
  }
}

[Test(Shop)]
void agent_work_that_had_finished_is_answered_from_its_receipt_with_no_model_called() {
  var id = NoraReports();
  Guid first = Guid.Empty;
  runas (Sana) {
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
    first = Investigate(Case(id)).Task;
  }
  Background.Settle();
  runas (Sana) {
    // The step is run again — a process that was restarted after the work had finished. No model answers this time.
    ScriptedAnswer.Stub((model, request) => { throw new InvalidOperationException("No model should be asked."); });
    var again = Investigate(Case(id));
    Assert.True(again.Done);
    Assert.Equal(first, again.Task);
    Assert.True(again.Result.Lost);
    Assert.Equal("Held as damaged at the Malmö depot since 6 March.", again.Result.What);
    var again1 = Case(id).Assignment;
    Assert.Equal(1, again1.Work.Count());
    Assert.Equal(800, CostOf(Case(id).Assignment).WorkMicros);
  }
  runas (Lars) { Assert.Equal(1, AgentTask.Count()); }
}

[Test(Shop)]
void work_that_failed_is_a_new_attempt_beside_the_old_one() {
  var id = NoraReports();
  runas (Sana) {
    // The model never manages a finding that fits: the work fails.
    var bad = AgentScript.Of(Says.HandBack(new DeliveryFinding { Suggests = "shrug" }), Says.HandBack(new DeliveryFinding { Suggests = "dunno" }));
    ScriptedAnswer.Stub((model, request) => bad.Answer(model, request));
    var failed = Investigate(Case(id));
    Assert.Equal(AgentTaskStatus.Failed, failed.Status);
    var a = Case(id).Assignment;
    Assert.Equal(WorkState.Failed, WorkOf(a, "investigate")!.State);
    Assert.StartsWith("Resolver could not finish:", WorkOf(a, "investigate")!.Result);
    // What it spent failing is still the case's cost.
    Assert.Equal(400, CostOf(a).WorkMicros);

    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
    Assert.True(Investigate(Case(id)).Done);
    a = Case(id).Assignment;
    Assert.Equal(WorkState.Failed, WorkOf(a, "investigate")!.State);
    Assert.Equal(WorkState.Done, WorkOf(a, "investigate#2")!.State);
    Assert.Equal("Find out where order T-1042 is (attempt 2)", WorkOf(a, "investigate#2")!.Title);
    Assert.Equal(1200, CostOf(a).WorkMicros);
  }
}

// ── money ───────────────────────────────────────────────────────────────────────────────────────────────────────────

[Test(Shop)]
void budget_exhaustion_completes_partially_with_the_findings_kept() {
  var id = NoraReports();
  runas (Sana) {
    // A glance has 12,000 millionths. Each answer costs 6,000: the third is refused before it is sent.
    var script = AgentScript.Of(
      Says.Tool(Actions.Of(TrackParcel), OrderArg(Case(id)), 3000, 600),
      Says.Tool(Actions.Of(NoteEvidence), EvidenceArgs(Case(id)), 3000, 600),
      Says.HandBack(new DeliveryFinding { Lost = true, Suggests = "refund" }, 3000, 600));
    ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
    var outcome = Glance(Case(id));
    Assert.Equal(AgentTaskStatus.Stopped, outcome.Status);

    var a = Case(id).Assignment;
    var work = WorkOf(a, "glance")!;
    Assert.Equal(WorkState.Failed, work.State);
    Assert.StartsWith("Resolver was stopped:", work.Result);
    Assert.Equal(12000, work.CostMicros);
    Assert.Equal(12000, CostOf(a).TotalMicros);
    // What it had written down before the money ran out is kept.
    var evidence = ItemsOf(a, ItemKind.Evidence).Single();
    Assert.Equal("Last scan 6 March, Malmö depot: damaged, held. Nothing since.", CurrentOf(evidence).Content);

    // The case is closed as far as it got: it failed, it says what was established and what was not.
    FailAssignment(a, "The money set aside for this case ran out before it was settled.",
                   limitations: "The parcel's last scan is on file; no refund or replacement was made.");
    var closed = Case(id).Assignment;
    Assert.Equal(AssignmentState.Failed, closed.State);
    Assert.Equal(1, ItemsOf(closed, ItemKind.Evidence).Count);
    Assert.Equal(CriterionState.Unmet, CriterionOf(closed, "resolved").State);
  }
}

[Test(Shop)]
void an_assignment_whose_budget_is_spent_starts_no_more_agent_work() {
  var id = NoraReports();
  runas (Sana) {
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
    Investigate(Case(id));
    // The lead trims the case's budget to less than it has already spent.
    SetAssignmentBudget(Case(id).Assignment, 0.0005m);
  }
  runas (Sana) {
    var refused = Assert.Throws<AssignmentBudgetSpent>(() => Settle(Case(id)));
    Assert.Equal("“Order T-1042 has not arrived” has spent its budget ($0.0008 of $0.0005). Nothing more is started on its account.", refused.Message);
    Assert.Null(WorkOf(Case(id).Assignment, "settle"));
    Assert.Equal(OrderStatus.Shipped, ShopOrder.Single(o => o.Number == "T-1042").Status);
  }
  runas (Lars) { Assert.Equal(1, AgentTask.Count()); }
}

// ── who may give the agent work on a case ───────────────────────────────────────────────────────────────────────────

[Test(Shop)]
void an_agent_that_is_not_on_the_assignment_does_no_work_for_it() {
  Guid other = Guid.Empty;
  runas (Sana) {
    var order = ShopOrder.Single(o => o.Number == "T-1050");
    var a = OpenAssignment(new NewAssignment { Title = "Order T-1050 is late", Goal = "The customer has the order.", Criteria = ["Delivered"] });
    other = new DeliveryCase { Order = order, Assignment = a }.Id;
  }
  runas (Sana) {
    var refused = Assert.Throws<AssignmentRefused>(() => Investigate(Case(other)));
    Assert.Contains("Resolver is not on “Order T-1050 is late”, so it cannot work on it.", refused.Message);
    var bare = Case(other).Assignment;
    Assert.Equal(0, bare.Work.Count());
  }
  runas (Lars) { Assert.Equal(0, AgentTask.Count()); }
}

[Test(Shop)]
void somebody_who_is_not_on_a_case_gives_the_agent_no_work_on_it() {
  var id = NoraReports();
  // Tim is in support, and may give the agent work — on his own cases. He is not on Nora's.
  runas (Tim) {
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
    var refused = Assert.Throws<NotFoundException>(() => Investigate(Case(id)));
    Assert.Contains("that the current caller cannot read", refused.Message);
  }
  // Put on it to watch, he reads it — and still starts nothing on it.
  runas (Sana) { AddParticipant(Case(id).Assignment, Tim, ParticipantRole.Observer); }
  runas (Tim) {
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
    Assert.Equal("Order T-1042 has not arrived", Case(id).Assignment.Title);
    Assert.Denied(() => Investigate(Case(id)));
  }
  runas (Lars) {
    Assert.Equal(0, AgentTask.Count());
    var untouched = Case(id).Assignment;
    Assert.Equal(0, untouched.Work.Count());
  }
}

[Test(Shop)]
void the_agent_writes_to_a_case_only_what_whoever_asked_may() {
  var id = NoraReports();
  // The lead oversees every case and asks the agent to look. Its tools run as the agent, for him: both may write.
  runas (Lars) {
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
    Assert.True(Investigate(Case(id)).Done);
    Assert.Equal(1, ItemsOf(Case(id).Assignment, ItemKind.Evidence).Count);
  }
  // Omar is a customer with a case of his own. An item of Nora's case is not his to read through the agent's tools
  // either: a tool asked to read it is handed nothing.
  Guid evidence = Guid.Empty;
  runas (Lars) { evidence = ItemsOf(Case(id).Assignment, ItemKind.Evidence).Single().Id; }
  runas (Omar) {
    Assert.Equal(0, RepositoryItem.Count());
    Assert.Equal(0, Assignment.Count());
  }
}

/// Calling an assignment off stops the agent work that is running for it: the work's receipt is on the case before
/// the run begins, so whoever calls the case off reaches it. Here the customer finds the parcel while the agent is
/// still looking; the model's answer arrives after the case was called off, and the work ends at its next step.
[Test(Shop)]
void cancelling_an_assignment_calls_off_its_running_agent_work() {
  var id = NoraReports();
  runas (Sana) {
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => {
      // While the model is "thinking" about its first answer, the case is called off.
      if (TurnOf(request) == 0) { CallCaseOff(id, "The customer found the parcel at a neighbour's."); }
      return script.Answer(model, request);
    });
    var outcome = Investigate(Case(id));
    Assert.Equal(AgentTaskStatus.Cancelled, outcome.Status);
    Assert.Equal("It was called off: The assignment was called off.", outcome.Problem);
  }
  Background.Settle();
  runas (Sana) {
    var a = Case(id).Assignment;
    Assert.Equal(AssignmentState.Cancelled, a.State);
    var work = WorkOf(a, "investigate")!;
    var receipt = AssignedWork.ReceiptOf(work);
    Assert.NotNull(receipt);
    Assert.Equal(AgentTaskStatus.Cancelled, receipt!.Status);
    // One model call was made and paid for; no tool ran, and nothing was written to the case.
    Assert.Equal(1, receipt!.ModelCalls);
    Assert.Equal(0, receipt!.ToolCalls);
    Assert.Equal(0, ItemsOf(a).Count);
    Assert.Equal(200, CostOf(a).TotalMicros);
  }
}

/// An assignment's cost is charged as its agent work spends — not when the work reports back — and the work is
/// held to what the assignment has left while it runs.
[Test(Shop)]
void agent_work_is_charged_to_its_assignment_as_it_spends_and_held_to_what_is_left() {
  var id = NoraReports();
  runas (Sana) {
    var script = InvestigationScript(Case(id));
    ScriptedAnswer.Stub((model, request) => {
      new Heard { What = "case cost", About = TurnOf(request).ToString() + ":" + CaseCost(id).ToString() };
      return script.Answer(model, request);
    });
    Assert.True(Investigate(Case(id)).Done);
    // Before each of the four answers the case had been charged for the ones before it: 0, 200, 400, 600.
    Assert.Equal(["0:0", "1:200", "2:400", "3:600"], Heard.Where(h => h.What == "case cost").OrderBy(h => h.About).ToList().Select(h => h.About).ToList());
    var cost = CostOf(Case(id).Assignment);
    Assert.Equal(800, cost.WorkMicros);
    Assert.Equal(0, cost.OwnMicros);
    Assert.Equal(800, cost.TotalMicros);
  }
  // The lead leaves the case 0.0045 in all: 800 is spent, and what is left is less than one call reserves.
  runas (Lars) { SetAssignmentBudget(Case(id).Assignment, 0.0045m); }
  runas (Sana) {
    var script = SettlementScript(Case(id));
    ScriptedAnswer.Stub((model, request) => { new Heard { What = "asked to settle" }; return script.Answer(model, request); });
    var outcome = Settle(Case(id));
    Assert.Equal(AgentTaskStatus.Stopped, outcome.Status);
    Assert.Contains("no room left in the limit set for assignment:", outcome.Problem);
    // Nothing was sent to a model, and nothing was refunded.
    Assert.Equal(0, Heard.Count(h => h.What == "asked to settle"));
    Assert.Equal(OrderStatus.Shipped, ShopOrder.Single(o => o.Number == "T-1042").Status);
    Assert.Equal(800, CostOf(Case(id).Assignment).TotalMicros);
  }
}

// ── owed to other slices ────────────────────────────────────────────────────────────────────────────────────────────

/// Calling an assignment off must also list what was already promised to somebody outside — a courier booked, a
/// supplier asked. Commitments to other systems are not modelled yet.
[Test(Shop)]
[Skip("KNOWN-GAP: commitments to other systems arrive with Osysharp.Capabilities (release 2); until then nothing writes what is still owed outside into the obligations of an assignment that is called off.")]
void cancelling_with_an_external_commitment_lists_the_commitment() {
  var id = NoraReports();
  runas (Sana) {
    var a = Case(id).Assignment;
    var commitment = AttachWork(a, new WorkAttachment { Kind = WorkKind.Handoff, Key = "courier-pickup", Title = "Pickup booked with the courier", WaitingFor = "the courier's confirmation" });
    CancelAssignment(a, "The customer found the parcel at a neighbour's.");
    // What was promised to the courier is listed as still owed an answer, not silently dropped.
    Assert.Contains("Pickup booked with the courier", a.Obligations);
  }
}
